generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NextAuth Models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("ADMIN")
  accounts      Account[]
  sessions      Session[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Business Models

model CompanySettings {
  id               String   @id @default("default")
  logoUrl          String?
  companyName      String
  address          String?
  email            String?
  phone            String?
  quotationMessage String?
  bottomDetails    String?
  updatedAt        DateTime @updatedAt
}

model Supplier {
  id        String     @id
  name      String
  contact   String?
  products          Product[]
  productSuppliers  ProductSupplier[]
  quotationItems    QuotationItem[]
  purchases         Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Client {
  id         String      @id
  name       String
  contact    String?
  quotations Quotation[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Product {
  id                  String             @id
  imageUrl            String?
  materialCode        String             @unique
  materialDescription String
  specification       String?
  make                String?
  modelNo             String?
  unit                String             // e.g., NUM, KG
  costPrice           Int                // stored in paise
  sellingPrice        Int                // stored in paise
  gstRate             Float              // e.g., 18.0
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  productSuppliers    ProductSupplier[]
  quotationItems      QuotationItem[]
  purchaseItems       PurchaseItem[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Quotation {
  id          String          @id
  prNo        String?
  rfqNo       String?
  status      String          @default("DRAFT") // DRAFT, PENDING, ACCEPTED, REJECTED
  totalAmount Int             // paise (excluding GST)
  totalGst    Int             // paise
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  items       QuotationItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model QuotationItem {
  id           String    @id
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Int
  itemsNo      String?   // Items No from excel
  spSnapshot   Int       // Selling price at the time of quotation (paise)
  cpSnapshot   Int?      // Cost price at the time of quotation (paise)
  gstSnapshot  Float
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
}

model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  costPrice  Int      // paise
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([productId, supplierId])
}

model Purchase {
  id          String         @id
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  totalAmount Int            // paise (excluding GST)
  totalGst    Int            // paise
  items       PurchaseItem[]
  date        DateTime       @default(now())
}

model PurchaseItem {
  id          String   @id
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  cpSnapshot  Int      // Cost price at the time of purchase (paise)
}
