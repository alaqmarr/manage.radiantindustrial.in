generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// NextAuth Models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("ADMIN")
  accounts      Account[]
  sessions      Session[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Business Models

model CompanySettings {
  id               String   @id @default("default")
  logoUrl          String?
  signatureUrl     String?
  companyName      String
  address          String?
  billingAddress   String?
  shippingAddress  String?
  email            String?
  phone            String?
  quotationMessage String?
  rfqMessage       String?
  cocMessage       String?
  bottomDetails    String?
  
  // Email / SMTP Settings
  smtpEmail        String?
  smtpPassword     String?

  // Banking Details
  bankName         String?
  accountName      String?
  accountNumber    String?
  ifscCode         String?

  // Integrations
  gstApiKey        String?
  swiftCode        String?
  bankAddress      String?

  // Alerts
  marginAlertThreshold Float  @default(10.0) // percentage

  updatedAt        DateTime @updatedAt
}

model Supplier {
  id        String     @id
  name      String
  contact   String?
  email     String?
  gstNumber String?
  location  String?
  products          Product[]
  productSuppliers  ProductSupplier[]
  quotationItems    QuotationItem[]
  purchases         Purchase[]
  purchaseOrders   PurchaseOrder[]
  rfqs              Rfq[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Client {
  id         String      @id
  name       String
  contact    String?
  email      String?
  gstNumber  String?
  location   String?
  address    String?
  quotations Quotation[]
  cocs       CertificateOfConformance[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Product {
  id                  String             @id
  imageUrl            String?
  materialCode        String             @unique
  materialDescription String
  specification       String?
  make                String?
  modelNo             String?
  unit                String             // e.g., NUM, KG
  costPrice           Int                // stored in paise
  commissionCostPrice Int?               // faked cost price for commission calculations (paise)
  sellingPrice        Int                // stored in paise
  gstRate             Float              // e.g., 18.0
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  productSuppliers    ProductSupplier[]
  quotationItems      QuotationItem[]
  purchaseItems       PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  rfqItems            RfqItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  priceHistory        PriceHistory[]
  cocItems            CocItem[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Quotation {
  id               String          @id
  prNo             String?
  rfqNo            String?
  status           String          @default("DRAFT") // DRAFT, PENDING, ACCEPTED, REJECTED
  paymentStatus    String          @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  paymentDueDate   DateTime?
  amountPaid       Int             @default(0) // paise
  totalAmount      Int       // paise (excluding GST)
  totalGst         Int       // paise
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  items            QuotationItem[]
  payments         Payment[]
  cocs             CertificateOfConformance[]
  purchases        Purchase[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model QuotationItem {
  id           String    @id
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Float
  itemsNo      String?   // Items No from excel
  spSnapshot   Int       // Selling price at the time of quotation (paise)
  cpSnapshot   Int?      // Cost price at the time of quotation (paise)
  commissionCpSnapshot Int? // Faked cost price for commission at time of quotation (paise)
  gstSnapshot  Float
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  comment      String?   // User comment for this item in the quotation
  additionalCost Int?    @default(0) // paise. Internal cost (e.g. freight) borne by us, reduces profit.
}

model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  costPrice  Int      // paise
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([productId, supplierId])
}

model Purchase {
  id            String         @id
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  totalAmount   Int            // paise (excluding GST)
  totalGst      Int            // paise
  paymentStatus String         @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  amountPaid    Int            @default(0) // paise
  quotationId   String?
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  items         PurchaseItem[]
  payments      Payment[]
  date          DateTime       @default(now())
}

model PurchaseItem {
  id          String   @id
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Float
  cpSnapshot  Int      // Cost price at the time of purchase (paise)
}

model Rfq {
  id          String    @id
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  status      String    @default("DRAFT") // DRAFT, ISSUED, COMPLETED
  totalAmount Int?      // deprecated
  totalGst    Int?      // deprecated
  items       RfqItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RfqItem {
  id          String   @id
  rfqId       String
  rfq         Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Float
  cpSnapshot  Int?      // deprecated
  gstSnapshot Float?    // deprecated
  comment     String?
}

model PurchaseOrder {
  id                   String              @id
  poNumber             String?             @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  rfqId                String?             // Optional link to Rfq
  status               String              @default("DRAFT") // DRAFT, ISSUED, ACKNOWLEDGED, COMPLETED, CANCELLED
  paymentStatus        String              @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  paymentDueDate       DateTime?
  amountPaid           Int                 @default(0) // paise
  paymentTerms         String?
  deliveryTerms        String?
  expectedDeliveryDate DateTime?
  notes                String?
  totalAmount          Int                 // paise (excluding GST)
  totalGst             Int                 // paise
  items                PurchaseOrderItem[]
  payments             Payment[]
  deliveries           GoodsReceipt[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model PurchaseOrderItem {
  id          String        @id
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Float
  unitPrice   Int           // paise (vendor quoted price)
  gstRate     Float
  comment     String?
}

model Payment {
  id             String         @id @default(cuid())
  type           String         @default("IN") // "IN" or "OUT"
  status         String         @default("CLEARED") // "PENDING", "CLEARED", "BOUNCED", "CANCELLED"
  amount         Int            // paise
  method         String?        // BANK_TRANSFER, CASH, CHEQUE, UPI
  reference      String?        // Cheque no / UTR / transaction ref
  notes          String?
  date           DateTime       @default(now())
  quotationId    String?
  quotation      Quotation?     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  poId           String?
  po             PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Cascade)
  purchaseId     String?
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
}

model GoodsReceipt {
  id             String              @id @default(cuid())
  poId           String
  po             PurchaseOrder       @relation(fields: [poId], references: [id], onDelete: Cascade)
  receivedDate   DateTime            @default(now())
  grnNumber      String?
  notes          String?
  items          GoodsReceiptItem[]
  createdAt      DateTime            @default(now())
}

model GoodsReceiptItem {
  id               String        @id @default(cuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityReceived Float
}

model PriceHistory {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costPrice    Int      // paise
  sellingPrice Int      // paise
  changedAt    DateTime @default(now())
}

model CertificateOfConformance {
  id               String          @id
  cocNumber        String?         @unique
  status           String          @default("DRAFT") // DRAFT, ISSUED, CANCELLED
  date             DateTime        @default(now())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  quotationId      String?
  quotation        Quotation?      @relation(fields: [quotationId], references: [id])
  clientPoRef      String?
  standardText     String?
  remarks          String?
  items            CocItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CocItem {
  id               String                   @id @default(cuid())
  cocId            String
  coc              CertificateOfConformance @relation(fields: [cocId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  quantity         Float
  batchNo          String?
  remarks          String?
  attributes       String? // JSON string for key-value pairs
}
